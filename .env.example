# K&K Restaurant - Environment configuration
# Copy this file to .env on the server and replace every secret.

SECRET_KEY=GENERATE_WITH_PYTHON_SECRETS
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERATE_WITH_python_bootstrap_admin.py

# Local HTTP = 0. Production HTTPS = 1
SESSION_COOKIE_SECURE=0
FORCE_HTTPS=0
HSTS_ENABLED=0
CSP_ENABLED=0

# Set to 1 only when Flask is behind a trusted reverse proxy (Nginx/Apache).
TRUST_PROXY=0

# Optional
DISABLE_AUTO_BACKUP=0
